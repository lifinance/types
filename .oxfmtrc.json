{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.yml",
    "**/*.yaml",
    "CHANGELOG.md",
    "LICENSE.md",
    "pnpm-lock.yaml",
    "**/.claude/**",
    ".changeset/*.md"
  ]
}
